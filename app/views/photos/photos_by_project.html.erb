<div class="containersup">
  <% @photos.each_with_index do |photo, n| %>
    <div class="gallery-container w-3 h-2">
      <div class="gallery-item">
        <div class="image" data-bs-toggle="modal" data-bs-target="#lightbox" data-slide-to="<%= n %>">
          <img src="<%= cl_image_path photo.photo.key, width: 600, height: 600, crop: :fill, quality: :auto, fetch_format: :auto %>" loading="<%= n.zero? ? "eager" : "lazy" %>" />
        </div>
      </div>
    </div>
  <% end %>
</div>

<!-- Modal -->
<div class="modal fade lightbox-modal" id="lightbox" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div id="indicators" data-bs-ride="carousel" class="carousel slide">
        <div class="carousel-indicators">
          <% @photos.each_with_index do |photo, n| %>
            <button type="button" data-bs-target="#indicators" data-bs-slide-to="<%= n %>" class="<%= 'active' if n.zero? %>" aria-current="<%= 'true' if n.zero? %>" aria-label="Slide <%= n + 1 %>"></button>
          <% end %>
        </div>
        <div class="carousel-inner" role="listbox">
          <% @photos.each_with_index do |photo, n| %>
            <div class="carousel-item <%= 'active' if n.zero? %>">
              <img class="d-block w-100"
               src="<%= cl_image_path photo.photo.key, width: 1200, crop: :limit, quality: :auto, fetch_format: :auto %>" loading="<%= n.zero? ? "eager" : "lazy" %>">
              <p class="carousel-photo-caption text-center mt-1"><%= photo.description %></p>
            </div>
          <% end %>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#indicators" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#indicators" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>
    </div>
  </div>
</div>
