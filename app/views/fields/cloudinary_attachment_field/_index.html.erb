<!-- app/views/fields/cloudinary_attachment_field/_index.html.erb -->
<% if field.data.present? %>
  <%= image_tag cl_image_path(field.data.key, width: 100, crop: :limit, quality: :auto, fetch_format: :auto), alt: 'Cloudinary Image', style: 'width: 50px; height: auto;' %>
<% else %>
  No image available.
<% end %>
