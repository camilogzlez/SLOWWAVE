<div class="hg-pool-item" draggable="true" data-photo-id="<%= photo.id %>">
  <img src="<%= photo.thumbnail_url %>" alt="<%= photo.title %>" loading="lazy" draggable="false">
  <span class="hg-pool-title"><%= photo.title %></span>
  <button type="button" class="hg-add" title="Add to the end of the home page">+</button>
</div>
