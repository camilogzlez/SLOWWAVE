<%#
  Bulk actions for the photo cards on the current page.

  Locals:
  - all_categories: Category.includes(:subcategories).order(:name)
  - all_projects: Project.order(:title)
%>
<div class="bulk-toolbar" hidden
  data-assign-url="<%= bulk_assign_admin_photos_path %>"
  data-destroy-url="<%= bulk_destroy_admin_photos_path %>">
  <div class="bulk-toolbar-group">
    <strong><span class="bulk-count">0</span> selected</strong>
    <button type="button" class="bulk-select-all">Select all on this page</button>
    <button type="button" class="bulk-clear">Clear</button>
  </div>

  <div class="bulk-toolbar-group">
    <select class="bulk-category">
      <option value="">Category…</option>
      <% all_categories.each do |category| %>
        <option value="<%= category.id %>"><%= category.name %></option>
      <% end %>
    </select>
    <select class="bulk-subcategory" hidden>
      <option value="">(no subcategory)</option>
      <% all_categories.each do |category| %>
        <% category.subcategories.each do |subcategory| %>
          <option value="<%= subcategory.id %>" data-category-id="<%= category.id %>"><%= subcategory.name %></option>
        <% end %>
      <% end %>
    </select>
    <button type="button" class="bulk-add-category">Add to category</button>
  </div>

  <div class="bulk-toolbar-group">
    <select class="bulk-project">
      <option value="">Project…</option>
      <% all_projects.each do |project| %>
        <option value="<%= project.id %>"><%= project.title %></option>
      <% end %>
    </select>
    <button type="button" class="bulk-add-project">Add to project</button>
  </div>

  <div class="bulk-toolbar-group">
    <button type="button" class="bulk-delete button--danger">Delete</button>
    <span class="save-status save-status--error bulk-error" aria-live="polite"></span>
  </div>
</div>
