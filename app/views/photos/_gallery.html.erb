<div class="photo-gallery" data-view="carousel">
  <div class="containersup gallery-grid">
    <% photos.each_with_index do |photo, n| %>
      <div class="gallery-container w-3 h-2">
        <div class="gallery-item">
          <div class="image" data-slide-to="<%= n %>">
            <img src="<%= photo.thumbnail_url %>" loading="lazy" alt="<%= photo.title %>" />
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <section class="gallery-carousel-view">
    <div class="gallery-topbar">
      <span class="gallery-counter"><span class="gallery-counter-current">1</span> / <%= photos.size %></span>
      <button class="gallery-control gallery-view-toggle" type="button" data-show-view="grid" data-tooltip="Grid view" aria-label="Grid view">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="6.5" height="6.5" /><rect x="13.5" y="4" width="6.5" height="6.5" /><rect x="4" y="13.5" width="6.5" height="6.5" /><rect x="13.5" y="13.5" width="6.5" height="6.5" /></svg>
      </button>
      <button class="gallery-control gallery-close" type="button" data-show-view="grid" aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>

    <%# pause: false, since the carousel fills the screen and the mouse is always over it. %>
    <div id="gallery-carousel" data-bs-ride="carousel" data-bs-pause="false" class="carousel slide">
      <div class="carousel-inner" role="listbox">
        <% photos.each_with_index do |photo, n| %>
          <div class="carousel-item <%= 'active' if n.zero? %>">
            <img class="d-block" src="<%= photo.full_url %>" loading="<%= n < 2 ? "eager" : "lazy" %>" alt="<%= photo.title %>">
            <p class="carousel-photo-caption text-center"><%= photo.description %></p>
          </div>
        <% end %>
        <button class="gallery-side gallery-side--prev" type="button" data-bs-target="#gallery-carousel" data-bs-slide="prev" aria-label="Previous photo"></button>
        <button class="gallery-side gallery-side--next" type="button" data-bs-target="#gallery-carousel" data-bs-slide="next" aria-label="Next photo"></button>
      </div>

      <button class="gallery-control gallery-arrow gallery-arrow--prev" type="button" data-bs-target="#gallery-carousel" data-bs-slide="prev" aria-label="Previous photo">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button class="gallery-control gallery-arrow gallery-arrow--next" type="button" data-bs-target="#gallery-carousel" data-bs-slide="next" aria-label="Next photo">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </section>

  <button class="gallery-control gallery-carousel-return" type="button" data-show-view="carousel" data-tooltip="Carousel view" aria-label="Carousel view">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="5" width="14" height="14" /><path d="M2 9v6M22 9v6" /></svg>
  </button>
</div>
