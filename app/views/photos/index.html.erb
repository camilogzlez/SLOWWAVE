<div class="containersup home-grid">
  <% @home_tiles.each_with_index do |tile, n| %>
    <div class="gallery-container w-<%= tile.column_span %> h-<%= tile.row_span %>">
      <div class="gallery-item">
        <div class="index-image">
          <img src="<%= tile.image_url %>" alt="<%= tile.photo.title %>" loading="<%= n < 2 ? "eager" : "lazy" %>">
        </div>
      </div>
    </div>
  <% end %>
</div>
